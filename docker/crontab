# ZenScail scheduled jobs (replaces vercel.json "crons").
# Run by the `cron` service via supercronic, which inherits the container's
# environment — so $CRON_SECRET below is expanded from the service env.
# Jobs hit the app over the internal compose network (service name `app`).
#
# min hour dom mon dow   command

# Daily brief for every Corsair-connected user — 03:30 UTC
30 3 * * *    curl -fsS --max-time 290 -H "Authorization: Bearer $CRON_SECRET" http://app:3000/api/cron/daily-summary

# Re-surface snoozed threads whose time has come — every 5 min
*/5 * * * *   curl -fsS --max-time 55  -H "Authorization: Bearer $CRON_SECRET" http://app:3000/api/cron/snooze-wake

# Deliver pending "send later" / undo-window messages — every 5 min
*/5 * * * *   curl -fsS --max-time 115 -H "Authorization: Bearer $CRON_SECRET" http://app:3000/api/cron/scheduled-send

# Check armed follow-ups and nudge / clear them — hourly
0 * * * *     curl -fsS --max-time 115 -H "Authorization: Bearer $CRON_SECRET" http://app:3000/api/cron/follow-ups
