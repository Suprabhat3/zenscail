generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String    @id
  name            String
  email           String    @unique
  emailVerified   Boolean   @default(false)
  image           String?
  corsairTenantId String?   @map("corsair_tenant_id")
  // The Gmail address actually connected via Corsair — may differ from `email`
  // (the app-login identity). This is the real mailbox the user is reading.
  connectedEmail  String?   @map("connected_email")
  // Set once the welcome/onboarding email has been sent, so it's never duplicated.
  welcomedAt      DateTime? @map("welcomed_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  sessions        Session[]
  accounts        Account[]
  aiSettings      UserAiSettings?

  @@map("user")
}

model UserAiSettings {
  id              Int      @id @default(autoincrement())
  userId          String   @unique @map("user_id")
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tier            String   @default("cloud") // "cloud" | "byok"
  provider        String? // "openai" | "anthropic" | "google" (byok only)
  model           String?
  encryptedApiKey String?  @map("encrypted_api_key") // AES-256-GCM, see lib/crypto.ts
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("user_ai_settings")
}

model EmailMeta {
  id              Int      @id @default(autoincrement())
  userId          String   @map("user_id")
  gmailMessageId  String   @map("gmail_message_id")
  priority        String // "urgent" | "normal" | "low"
  reason          String?
  createdAt       DateTime @default(now()) @map("created_at")

  @@unique([userId, gmailMessageId])
  @@index([userId, priority])
  @@map("email_meta")
}

model DailyBrief {
  id          Int      @id @default(autoincrement())
  userId      String   @map("user_id")
  date        String // "YYYY-MM-DD" in the user's day (server local)
  headline    String
  overview    String // markdown body
  actionItems Json     @map("action_items") // BriefActionItem[] — see lib/ai/brief.ts
  events      Json // BriefEvent[] — today's calendar snapshot at generation time
  stats       Json // { emailsReviewed, urgentCount, meetingsToday }
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([userId, date])
  @@map("daily_brief")
}

model InboxEvent {
  id        Int      @id @default(autoincrement())
  userId    String   @map("user_id")
  plugin    String // "gmail" | "googlecalendar"
  type      String // event kind from the Corsair webhook payload
  payload   Json // raw normalized webhook payload, for debugging/replay
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@map("inbox_event")
}

model Session {
  id        String   @id
  expiresAt DateTime @map("expires_at")
  token     String   @unique
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id")
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("verification")
}

model Waitlist {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  @@map("waitlist")
}
